---
import WeightPlot from './WeightPlot.astro';

interface MetricEntry {
  fecha: string;
  peso: number | null;
  cintura?: number | null;
  notas?: string | null;
}

interface Props {
  metrics: MetricEntry[];
  lineColor?: string;
  recentDays?: number;
}

const { metrics, lineColor = 'var(--accent)', recentDays = 28 } = Astro.props;

const withWeight = metrics
  .filter((m): m is MetricEntry & { peso: number } => m.peso != null)
  .sort((a, b) => a.fecha.localeCompare(b.fecha));

const n = withWeight.length;

// Ventana por defecto: las últimas 4 semanas respecto a la última medición
function addDays(fecha: string, days: number): string {
  const d = new Date(fecha + 'T12:00:00');
  d.setDate(d.getDate() + days);
  return d.toISOString().slice(0, 10);
}

const lastDate = n > 0 ? withWeight[n - 1].fecha : null;
const cutoff = lastDate ? addDays(lastDate, -recentDays) : null;
const recent = cutoff ? withWeight.filter((m) => m.fecha >= cutoff) : [];
const hasHistory = withWeight.length > recent.length;
---

<div class="wc">
  <p class="wc-title">
    Evolución del peso{hasHistory ? ' · últimas 4 semanas' : ''}
  </p>

  {n < 2 ? (
    <div class="wc-empty">
      <span>📉</span>
      {n === 0
        ? <p>Registra el peso cada lunes para ver la tendencia.</p>
        : <p>Solo 1 medición — añade otra el próximo lunes para ver la gráfica.</p>
      }
    </div>
  ) : (
    <>
      <WeightPlot
        points={recent.length >= 2 ? recent : withWeight}
        lineColor={lineColor}
        startLabel={hasHistory ? 'Hace 4 sem.' : 'Inicio'}
      />

      {hasHistory && (
        <details class="wc-history">
          <summary>Ver histórico ({withWeight.length} mediciones)</summary>
          <WeightPlot points={withWeight} lineColor={lineColor} startLabel="Inicio" />
        </details>
      )}
    </>
  )}
</div>

<style>
  .wc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    margin-bottom: 16px;
  }
  .wc-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .wc-empty {
    text-align: center;
    padding: 24px 16px;
    color: var(--muted);
    font-size: 13px;
  }
  .wc-empty span { font-size: 28px; display: block; margin-bottom: 8px; }
  .wc-empty p { margin: 0; }
  .wc-history {
    margin-top: 14px;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }
  .wc-history summary {
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px;
  }
</style>
