---
import {
  aggregateWeeklyBalance,
  DEFAULT_TDEE_BASE,
  getChartMode,
  type TrackingEntry,
} from '../utils/weeklyBalance';
import WeeklyBars from './WeeklyBars.astro';

interface Props {
  entries: TrackingEntry[];
  tdee: number;
  accent?: string;
  deficitColor?: string;
  surplusColor?: string;
  recentWeeks?: number;
}

const {
  entries,
  tdee,
  accent = 'var(--accent)',
  deficitColor = 'var(--green)',
  surplusColor = 'var(--yellow)',
  recentWeeks = 4,
} = Astro.props;

const totalDays = entries.length;
const mode = getChartMode(totalDays);
const weeks = aggregateWeeklyBalance(entries, tdee);

// Por defecto solo las últimas N semanas; el resto queda en "Ver histórico"
const recent = weeks.slice(-recentWeeks);
const hasHistory = weeks.length > recent.length;
const usesExercise = entries.some((e) => typeof e.ejercicio_kcal === 'number');
---

<div class="weekly-chart">
  <p class="weekly-chart-title">
    Balance semanal · {hasHistory ? `últimas ${recent.length} semanas` : 'todas las semanas'}
  </p>
  <p class="weekly-chart-sub">
    {usesExercise
      ? `Gasto = TDEE base ${DEFAULT_TDEE_BASE.toLocaleString('es-ES')} kcal + ejercicio registrado`
      : `TDEE estimado: ${tdee.toLocaleString('es-ES')} kcal/día`}
    {' '}· verde = déficit · ámbar = superávit
  </p>

  {mode === 'empty' ? (
    <div class="weekly-chart-empty">
      <span class="weekly-chart-empty-icon">📊</span>
      <p>
        Registra <strong>{7 - totalDays}</strong> día{7 - totalDays === 1 ? '' : 's'} más para ver la primera gráfica.
        <br />
        <span class="weekly-chart-muted">({totalDays}/7 días registrados)</span>
      </p>
    </div>
  ) : (
    <>
      {mode === 'preview' && (
        <div class="weekly-chart-notice">
          Vista previa — gráfica completa a partir de 2 semanas ({totalDays}/14 días)
        </div>
      )}

      <WeeklyBars
        weeks={recent}
        deficitColor={deficitColor}
        surplusColor={surplusColor}
        label={`Gráfica de balance calórico de las últimas ${recent.length} semanas`}
      />

      {weeks.length > 0 && (
        <div class="weekly-chart-summary">
          <span>
            Última semana: <strong style={`color: ${weeks[weeks.length - 1].balance >= 0 ? deficitColor : surplusColor}`}>
              {weeks[weeks.length - 1].balance >= 0 ? 'déficit' : 'superávit'}{' '}
              {Math.abs(weeks[weeks.length - 1].balance).toLocaleString('es-ES')} kcal
            </strong>
            {' '}({weeks[weeks.length - 1].daysLogged} días · media {weeks[weeks.length - 1].avgKcal} kcal/d)
          </span>
        </div>
      )}

      {hasHistory && (
        <details class="weekly-history">
          <summary>Ver histórico ({weeks.length} semanas)</summary>
          <WeeklyBars
            weeks={weeks}
            deficitColor={deficitColor}
            surplusColor={surplusColor}
            label="Gráfica de balance calórico del histórico completo"
          />
        </details>
      )}

      <p class="weekly-chart-foot">* Semana incompleta o en curso</p>
    </>
  )}
</div>

<style>
  .weekly-chart {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px;
    margin-bottom: 16px;
  }
  .weekly-chart-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 4px;
  }
  .weekly-chart-sub {
    font-size: 11px;
    color: var(--muted);
    margin: 0 0 12px;
    line-height: 1.4;
  }
  .weekly-chart-empty {
    text-align: center;
    padding: 20px 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }
  .weekly-chart-empty-icon {
    font-size: 28px;
    display: block;
    margin-bottom: 8px;
  }
  .weekly-chart-muted {
    font-size: 11px;
    opacity: 0.8;
  }
  .weekly-chart-notice {
    font-size: 11px;
    color: var(--accent);
    background: rgba(99, 102, 241, 0.08);
    border-radius: 8px;
    padding: 8px 10px;
    margin-bottom: 10px;
  }
  .weekly-chart-summary {
    font-size: 12px;
    color: var(--muted);
    margin-top: 10px;
    line-height: 1.45;
  }
  .weekly-history {
    margin-top: 12px;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }
  .weekly-history summary {
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .weekly-chart-foot {
    font-size: 10px;
    color: var(--muted);
    margin: 6px 0 0;
    opacity: 0.7;
  }
</style>
